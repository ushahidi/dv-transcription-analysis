# Copy this file to .env and fill in real values - .env itself is gitignored
# and must never be committed (see the "Secrets" section of README.md).
#
# IMPORTANT: nothing in this repo loads .env automatically. Python only reads
# os.environ - a value that only exists in .env, never exported into your
# actual shell environment, is silently invisible to every script here (it
# will look like the variable is simply unset, not error loudly). Before
# running anything that needs these, load the file into your shell first:
#
#   PowerShell:  Get-Content .env | ForEach-Object { if ($_ -match '^([^=]+)=(.*)$') { Set-Item "Env:$($Matches[1])" $Matches[2] } }
#   bash:        set -a && source .env && set +a
#
# (or just set the variables directly with $env:NAME = "..." / export NAME=...)

# Gemini Developer API key - free, from https://aistudio.google.com/apikey.
# No GCP project or billing required. See gemini/README.md.
GEMINI_API_KEY=
